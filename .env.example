# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# Optional: any OpenAI-compatible endpoint (DeepSeek, SiliconFlow, ...).
# When OPENAI_BASE_URL is set, LLM_MODELS replaces the built-in OpenAI registry.
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODELS=deepseek-chat,deepseek-reasoner
# SESSION_NAMING_MODEL=deepseek-chat

# Long-term memory (mem0) provider overrides.
# Embeddings can use a different OpenAI-compatible provider than the agent.
# LONG_TERM_MEMORY_MODEL=gpt-5-nano
# LONG_TERM_MEMORY_LLM_BASE_URL=
# LONG_TERM_MEMORY_LLM_API_KEY=
# Use `openai_compatible` for providers that reject the `dimensions` argument
# (e.g. SiliconFlow). Pair it with LONG_TERM_MEMORY_EMBEDDER_DIMS.
# LONG_TERM_MEMORY_EMBEDDER_PROVIDER=openai
# LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small
# LONG_TERM_MEMORY_EMBEDDER_BASE_URL=
# LONG_TERM_MEMORY_EMBEDDER_API_KEY=
# LONG_TERM_MEMORY_EMBEDDER_DIMS=1536

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
